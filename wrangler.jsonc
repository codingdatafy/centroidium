{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "centroidium",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "www.codingdatafy.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "CONTENT_BUCKET",
      "bucket_name": "codingdatafy-content"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "SITE_ANALYTICS",
      "dataset": "codingdatafy_analytics_dev"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://www.codingdatafy.com",
    "SITE_NAME": "CodingDatafy",
    "DEFAULT_CACHE_TTL": "86400"
  }
}