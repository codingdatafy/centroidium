{
  "name": "centroidium",
  "version": "1.0.0",
  "private": true,
  "description": "Native Cloudflare Worker engine and rendering core for CodingDatafy",
  "author": "CodingDatafy",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build:scripts": "esbuild src/scripts/*.ts --outdir=public/scripts --target=es2020 --bundle --minify",
    "build:styles": "esbuild public/styles/*.css --outdir=public/styles --minify",
    "build": "npm run build:scripts && npm run build:styles",
    "type-check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}