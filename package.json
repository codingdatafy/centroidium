{
  "name": "centroidium",
  "version": "1.0.0",
  "private": true,
  "description": "Native Cloudflare Worker engine and rendering core for CodingDatafy",
  "author": "CodingDatafy",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build:scripts": "esbuild src/scripts/centroidium.ts src/scripts/lib.ts --outdir=public/scripts --target=es2020 --minify",
    "type-check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}